# ---- game data: extracted from the retail disc, never commit ----
mw2/
*.xex
*.xexp
*.pe
*.iso

# ---- generated C++ (~2.2M lines, 64 MB) ----
ppc/
ppc_rs/
ppc_mp_rs/
ppc_tu0_rs/
ppc_mp_tu0_rs/
# where cargo xtask recompiles before copying what changed (xtask/src/main.rs)
ppc*.new/

# ---- cargo: the link to the tree in use, and what cargo xtask or a plain build makes.
# Cargo.lock is kept: every title has the same chunk crates (rust_chunk_count).
/generated
/generated.title
/target/
/xtask/target/

# ---- generated switch tables (XenonAnalyse output, rebuilt by cargo xtask) ----
config/mw2_switch_tables.toml

# ---- build artifacts ----
build/
build-release/
build-win*/
out/

# ---- editor / OS ----
.vscode/
.idea/
*.swp
.DS_Store

# ---- generated runtime glue ----
runtime/kernel/stubs_generated.cpp
ppc/kernel_imports.txt
__pycache__/
*.pyc
diagnosis/

# ---- the user's RenderDoc captures, hundreds of MB each ----
captures/

# ---- saved games the runtime writes beside the binary ----
saves/

# ---- the multiplayer executable's derived files (cargo xtask build --title mp) ----
ppc_mp/
build-mp/
build-mp-release/
config/mw2mp_switch_tables.toml

# ---- the disc version's derived files (cargo xtask build --tu0) ----
ppc_tu0/
ppc_mp_tu0/
build*-tu0/
config/*_switch_tables.tu0.toml

# ---- a development run's switches (docs/switches.md, "The settings file") ----
.env
